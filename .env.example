# --- Backend ---
# Postgres (locale: docker compose up -d db). Se manca, in sviluppo si usa SQLite locale.
DATABASE_URL=postgresql+psycopg://anime:anime@localhost:5432/anime
# Origini ammesse dal browser, separate da virgola (in produzione: il dominio Vercel).
CORS_ORIGINS=http://localhost:3000
# 1 = legge la chat Twitch (IRC anonimo, sola lettura). 0 nei test.
TWITCH_READER=1
# 1 = abilita /api/dev/fake-chat (simulatore di chat). NON attivarlo in produzione.
DEV_TOOLS=0

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# false = nasconde tutte le immagini dei personaggi (interruttore d'emergenza)
NEXT_PUBLIC_SHOW_IMAGES=true
# Indirizzo per le richieste di rimozione mostrato in /info
NEXT_PUBLIC_CONTACT_EMAIL=rimozioni@example.com
# Spazi pubblicitari: disattivati di default
NEXT_PUBLIC_ADS_ENABLED=false

# Segreto dei quiz (token e scelta della sfida del giorno). Se manca, si deriva da DATABASE_URL.
QUIZ_SECRET=
# Indirizzo pubblico del sito: serve ai link assoluti dell'immagine di condivisione (Open Graph).
NEXT_PUBLIC_SITE_URL=https://progetto-anime.vercel.app
