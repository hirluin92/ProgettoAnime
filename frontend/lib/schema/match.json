  "required": [
    "seed",
    "versione",
    "squadre",
    "unita",
    "potenze",
    "sinergie",
    "totali",
    "vincitore",
    "pareggio",
    "turni",
    "tattiche",
    "arena",
    "formazione",
    "rivalita",
    "carica",
    "eventi"
  ],
  "title": "MatchResult",
  "type": "object"
