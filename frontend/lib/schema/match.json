      "type": "object"
    },
    "unita": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/Unita"
        },
        "type": "array"
      },
      "propertyNames": {
        "enum": ["A", "B"]
      },
      "title": "Unita",
      "type": "object"
    },
    "potenze": {
      "additionalProperties": {
        "items": {
          "type": "integer"
        },
        "type": "array"
      },
      "propertyNames": {
        "enum": ["A", "B"]
      },
      "title": "Potenze",
      "type": "object"
    },
    "sinergie": {
      "items": {
        "$ref": "#/$defs/Sinergia"
      },
      "title": "Sinergie",
      "type": "array"
    },
    "totali": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": ["A", "B"]
      },
      "title": "Totali",
      "type": "object"
    },
    "vincitore": {
      "enum": ["A", "B"],
      "title": "Vincitore",
      "type": "string"
    },
    "pareggio": {
      "title": "Pareggio",
      "type": "boolean"
    },
    "turni": {
      "title": "Turni",
      "type": "integer"
    },
    "tattiche": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "propertyNames": {
        "enum": ["A", "B"]
      },
      "title": "Tattiche",
      "type": "object"
    },
    "arena": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arena"
    },
    "formazione": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "enum": ["A", "B"]
      },
      "title": "Formazione",
      "type": "object"
    },
    "rivalita": {
      "items": {
        "$ref": "#/$defs/RivalitaAttiva"
      },
      "title": "Rivalita",
      "type": "array"
    },
    "carica": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "enum": ["A", "B"]
      },
      "title": "Carica",
      "type": "object"
    },
    "eventi": {
      "items": {
        "discriminator": {
          "mapping": {
            "azione": "#/$defs/Azione",
            "effetti": "#/$defs/Effetti",
            "fase": "#/$defs/Fase",
            "fine": "#/$defs/Fine",
            "ingresso": "#/$defs/Ingresso",
            "respiro": "#/$defs/Respiro",
            "turno": "#/$defs/Turno"
          },
          "propertyName": "tipo"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/Ingresso"
          },
          {
            "$ref": "#/$defs/Turno"
          },
          {
            "$ref": "#/$defs/Fase"
          },
          {
            "$ref": "#/$defs/Azione"
          },
          {
            "$ref": "#/$defs/Effetti"
          },
          {
            "$ref": "#/$defs/Respiro"
          },
          {
            "$ref": "#/$defs/Fine"
          }
        ]
