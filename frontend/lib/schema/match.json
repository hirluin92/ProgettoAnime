{
  "$defs": {
    "Azione": {
      "properties": {
        "tipo": {
          "const": "azione",
          "default": "azione",
          "title": "Tipo",
          "type": "string"
        },
        "turno": {
          "title": "Turno",
          "type": "integer"
        },
        "da": {
          "enum": ["A", "B"],
          "title": "Da",
          "type": "string"
        },
        "idx": {
          "title": "Idx",
          "type": "integer"
        },
        "mossa": {
          "title": "Mossa",
          "type": "string"
        },
        "speciale": {
          "title": "Speciale",
          "type": "boolean"
        },
        "effetto": {
          "title": "Effetto",
          "type": "string"
        },
        "esiti": {
          "items": {
            "$ref": "#/$defs/Esito"
          },
          "title": "Esiti",
          "type": "array"
        },
        "stato": {
          "$ref": "#/$defs/Stato"
        }
      },
      "required": ["tipo", "turno", "da", "idx", "mossa", "speciale", "effetto", "esiti", "stato"],
      "title": "Azione",
      "type": "object"
    },
    "Character": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "nome": {
          "title": "Nome",
          "type": "string"
        },
        "anime": {
          "title": "Anime",
          "type": "string"
        },
        "ruolo_firma": {
          "title": "Ruolo Firma",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Tags",
          "type": "array"
        },
        "rating": {
          "maximum": 99,
          "minimum": 55,
          "title": "Rating",
          "type": "integer"
        },
        "immagine_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Immagine Url"
        },
        "arch": {
          "default": "BRU",
          "title": "Arch",
          "type": "string"
        },
        "mossa": {
          "$ref": "#/$defs/Mossa",
          "default": {
            "nome": "Colpo speciale",
            "effetto": "strike"
          }
        },
        "passiva": {
          "$ref": "#/$defs/Passiva",
          "default": {
            "nome": "Tempra",
            "effetto": "armor"
          }
        },
        "gruppi": {
          "items": {
            "type": "string"
          },
          "title": "Gruppi",
          "type": "array"
        },
        "costo": {
          "default": 6,
          "maximum": 14,
          "minimum": 1,
          "title": "Costo",
          "type": "integer"
        },
        "forma": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forma"
        },
        "base_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Id"
        }
      },
      "required": [
        "id",
        "nome",
        "anime",
        "ruolo_firma",
        "tags",
        "rating",
        "immagine_url",
        "arch",
        "mossa",
        "passiva",
        "gruppi",
        "costo",
        "forma",
        "base_id"
      ],
      "title": "Character",
      "type": "object"
    },
    "Effetti": {
      "description": "Danni da stati alterati a fine turno (bruciatura, veleno, corrosione).",
      "properties": {
        "tipo": {
          "const": "effetti",
          "default": "effetti",
          "title": "Tipo",
          "type": "string"
        },
        "turno": {
          "title": "Turno",
          "type": "integer"
        },
        "esiti": {
          "items": {
            "$ref": "#/$defs/Esito"
          },
          "title": "Esiti",
          "type": "array"
        },
        "stato": {
          "$ref": "#/$defs/Stato"
        }
      },
      "required": ["tipo", "turno", "esiti", "stato"],
      "title": "Effetti",
      "type": "object"
    },
    "Esito": {
      "properties": {
        "lato": {
          "enum": ["A", "B"],
          "title": "Lato",
          "type": "string"
        },
        "idx": {
          "title": "Idx",
          "type": "integer"
        },
        "delta": {
          "title": "Delta",
          "type": "integer"
        },
        "scudo": {
          "title": "Scudo",
          "type": "integer"
        },
        "ko": {
          "title": "Ko",
          "type": "boolean"
        },
        "schivata": {
          "title": "Schivata",
          "type": "boolean"
        },
        "crit": {
          "title": "Crit",
          "type": "boolean"
        },
        "stordito": {
          "title": "Stordito",
          "type": "boolean"
        },
        "effetto": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effetto"
        }
      },
      "required": [
        "lato",
        "idx",
        "delta",
        "scudo",
        "ko",
        "schivata",
        "crit",
        "stordito",
        "effetto"
      ],
      "title": "Esito",
      "type": "object"
    },
    "Fase": {
      "description": "Inizio di una fase: le tattiche scelte dai due lati e chi vince il confronto.",
      "properties": {
        "tipo": {
          "const": "fase",
          "default": "fase",
          "title": "Tipo",
          "type": "string"
        },
        "turno": {
          "title": "Turno",
          "type": "integer"
        },
        "fase": {
          "title": "Fase",
          "type": "integer"
        },
        "tattica": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "enum": ["A", "B"]
          },
          "title": "Tattica",
          "type": "object"
        },
        "esito": {
          "enum": ["A", "B", "pari"],
          "title": "Esito",
          "type": "string"
        }
      },
      "required": ["tipo", "turno", "fase", "tattica", "esito"],
      "title": "Fase",
      "type": "object"
    },
    "Fine": {
      "properties": {
        "tipo": {
          "const": "fine",
          "default": "fine",
          "title": "Tipo",
          "type": "string"
        },
        "vincitore": {
          "enum": ["A", "B"],
          "title": "Vincitore",
          "type": "string"
        },
        "motivo": {
          "enum": ["ko", "tempo"],
          "title": "Motivo",
          "type": "string"
        }
      },
      "required": ["tipo", "vincitore", "motivo"],
      "title": "Fine",
      "type": "object"
    },
    "Ingresso": {
      "properties": {
        "tipo": {
          "const": "ingresso",
          "default": "ingresso",
          "title": "Tipo",
          "type": "string"
        },
        "stato": {
          "$ref": "#/$defs/Stato"
        }
      },
      "required": ["tipo", "stato"],
      "title": "Ingresso",
      "type": "object"
    },
    "Mossa": {
      "properties": {
        "nome": {
          "title": "Nome",
          "type": "string"
        },
        "effetto": {
          "title": "Effetto",
          "type": "string"
        }
      },
      "required": ["nome", "effetto"],
      "title": "Mossa",
      "type": "object"
    },
    "Passiva": {
      "properties": {
        "nome": {
          "title": "Nome",
          "type": "string"
        },
        "effetto": {
          "title": "Effetto",
          "type": "string"
        }
      },
      "required": ["nome", "effetto"],
      "title": "Passiva",
      "type": "object"
    },
    "Respiro": {
      "description": "Ultimo respiro: l'ultimo superstite di una squadra riceve un bonus drammatico.",
