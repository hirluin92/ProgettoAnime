  "properties": {
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "versione": {
      "default": 2,
      "title": "Versione",
      "type": "integer"
    },
    "squadre": {
      "additionalProperties": {
        "$ref": "#/$defs/Team"
