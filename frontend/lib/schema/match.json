        "tipo": {
          "const": "respiro",
          "default": "respiro",
          "title": "Tipo",
          "type": "string"
        },
        "turno": {
          "title": "Turno",
          "type": "integer"
        },
        "lato": {
          "enum": ["A", "B"],
          "title": "Lato",
          "type": "string"
        },
        "idx": {
          "title": "Idx",
          "type": "integer"
        },
        "stato": {
          "$ref": "#/$defs/Stato"
        }
      },
      "required": ["tipo", "turno", "lato", "idx", "stato"],
      "title": "Respiro",
      "type": "object"
    },
    "RivalitaAttiva": {
      "description": "Due personaggi su lati opposti con un conto in sospeso: +8% di danno l'uno contro l'altro.",
      "properties": {
        "nome": {
          "title": "Nome",
          "type": "string"
        },
        "a": {
          "title": "A",
          "type": "integer"
        },
        "b": {
          "title": "B",
          "type": "integer"
        }
      },
      "required": ["nome", "a", "b"],
      "title": "RivalitaAttiva",
      "type": "object"
    },
    "Sinergia": {
      "properties": {
        "lato": {
          "enum": ["A", "B"],
          "title": "Lato",
          "type": "string"
        },
        "nome": {
          "title": "Nome",
          "type": "string"
        },
        "stat": {
          "title": "Stat",
          "type": "string"
        },
        "valore": {
          "title": "Valore",
