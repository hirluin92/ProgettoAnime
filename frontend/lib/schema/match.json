      "type": "object"
    },
    "Stato": {
      "description": "Fotografia del campo dopo un'azione (cos\u00ec l'interfaccia non deve rifare i conti).",
      "properties": {
        "hp": {
          "additionalProperties": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": ["A", "B"]
          },
          "title": "Hp",
          "type": "object"
        },
        "energia": {
          "additionalProperties": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": ["A", "B"]
          },
          "title": "Energia",
          "type": "object"
        },
        "scudo": {
          "additionalProperties": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": ["A", "B"]
          },
          "title": "Scudo",
          "type": "object"
        },
        "hype": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": ["A", "B"]
          },
          "title": "Hype",
          "type": "object"
        }
      },
      "required": ["hp", "energia", "scudo", "hype"],
      "title": "Stato",
      "type": "object"
    },
    "Team": {
      "properties": {
        "nome": {
          "title": "Nome",
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/Character"
          },
          "maxItems": 7,
          "minItems": 7,
          "title": "Members",
          "type": "array"
        },
        "bonus_missione": {
          "default": 0.0,
          "title": "Bonus Missione",
          "type": "number"
        }
      },
      "required": ["nome", "members", "bonus_missione"],
      "title": "Team",
      "type": "object"
    },
    "Turno": {
      "properties": {
        "tipo": {
          "const": "turno",
          "default": "turno",
          "title": "Tipo",
          "type": "string"
        },
        "n": {
          "title": "N",
          "type": "integer"
        }
      },
      "required": ["tipo", "n"],
      "title": "Turno",
      "type": "object"
    },
    "Unita": {
      "description": "Statistiche iniziali di un combattente (dopo ruolo, sinergie e legami).",
      "properties": {
        "hp": {
          "title": "Hp",
          "type": "integer"
        },
        "atk": {
          "title": "Atk",
          "type": "integer"
        },
        "dif": {
          "title": "Dif",
          "type": "integer"
        },
        "vel": {
          "title": "Vel",
          "type": "integer"
        },
        "adatto": {
          "title": "Adatto",
          "type": "boolean"
        }
      },
      "required": ["hp", "atk", "dif", "vel", "adatto"],
      "title": "Unita",
      "type": "object"
    }
