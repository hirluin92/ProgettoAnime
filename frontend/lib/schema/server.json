      "title": "Character",
      "type": "object"
    },
    "ErrorMsg": {
      "properties": {
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": ["type", "code", "message"],
      "title": "ErrorMsg",
      "type": "object"
    },
    "Joined": {
