          "title": "Player Id",
          "type": "string"
        },
        "amount": {
          "title": "Amount",
          "type": "integer"
        },
        "deadline": {
          "title": "Deadline",
          "type": "number"
        },
        "now": {
          "title": "Now",
          "type": "number"
        }
