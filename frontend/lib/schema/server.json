  "discriminator": {
    "mapping": {
      "auction_finished": "#/$defs/AuctionFinished",
      "bid_placed": "#/$defs/BidPlaced",
      "error": "#/$defs/ErrorMsg",
      "joined": "#/$defs/Joined",
      "lot_assigned": "#/$defs/LotAssigned",
      "lot_skipped": "#/$defs/LotSkipped",
      "lot_started": "#/$defs/LotStarted",
      "lot_won": "#/$defs/LotWon",
      "player_passed": "#/$defs/PlayerPassed",
      "room_state": "#/$defs/RoomState",
      "tournament_result": "#/$defs/TournamentResult"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Joined"
    },
    {
      "$ref": "#/$defs/RoomState"
    },
    {
      "$ref": "#/$defs/LotStarted"
    },
    {
      "$ref": "#/$defs/BidPlaced"
    },
    {
      "$ref": "#/$defs/PlayerPassed"
    },
    {
      "$ref": "#/$defs/LotWon"
    },
    {
      "$ref": "#/$defs/LotAssigned"
    },
    {
      "$ref": "#/$defs/LotSkipped"
    },
    {
      "$ref": "#/$defs/AuctionFinished"
    },
    {
      "$ref": "#/$defs/TournamentResult"
    },
    {
      "$ref": "#/$defs/ErrorMsg"
    }
  ]
