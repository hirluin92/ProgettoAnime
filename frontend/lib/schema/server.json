    "Character": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "nome": {
          "title": "Nome",
          "type": "string"
        },
        "anime": {
          "title": "Anime",
          "type": "string"
        },
        "ruolo_firma": {
          "title": "Ruolo Firma",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Tags",
          "type": "array"
