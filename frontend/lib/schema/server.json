          "title": "Teams",
          "type": "object"
        }
      },
      "required": ["type", "teams"],
      "title": "AuctionFinished",
      "type": "object"
    },
    "AwaitRole": {
      "properties": {
        "player_id": {
          "title": "Player Id",
          "type": "string"
