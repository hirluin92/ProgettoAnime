        "players": {
          "items": {
            "$ref": "#/$defs/PlayerView"
          },
          "title": "Players",
          "type": "array"
        },
        "lot": {
          "anyOf": [
            {
              "$ref": "#/$defs/LotView"
            },
            {
              "type": "null"
            }
          ]
        },
        "lots_left": {
          "title": "Lots Left",
          "type": "integer"
        },
        "tournament": {
          "anyOf": [
            {
              "$ref": "#/$defs/TournamentView"
            },
            {
              "type": "null"
            }
          ]
