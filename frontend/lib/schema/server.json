    "TournamentView": {
      "properties": {
        "giornate": {
          "items": {
            "items": {
              "$ref": "#/$defs/MatchRef"
            },
            "type": "array"
          },
          "title": "Giornate",
          "type": "array"
        },
        "classifica": {
          "items": {
            "$ref": "#/$defs/StandingRow"
