        "amount": {
          "title": "Amount",
          "type": "integer"
        },
        "deadline": {
          "title": "Deadline",
          "type": "number"
        }
      },
      "required": ["player_id", "amount", "deadline"],
      "title": "AwaitRole",
      "type": "object"
    },
    "BidPlaced": {
      "properties": {
        "type": {
          "const": "bid_placed",
          "default": "bid_placed",
          "title": "Type",
          "type": "string"
        },
