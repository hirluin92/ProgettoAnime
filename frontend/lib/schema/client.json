{
  "$defs": {
    "AssignRole": {
      "properties": {
        "type": {
          "const": "assign_role",
          "default": "assign_role",
          "title": "Type",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": ["type", "role"],
      "title": "AssignRole",
      "type": "object"
    },
    "Ban": {
      "properties": {
        "type": {
          "const": "ban",
          "default": "ban",
          "title": "Type",
          "type": "string"
        },
        "character_id": {
          "title": "Character Id",
          "type": "string"
        }
      },
      "required": ["type", "character_id"],
      "title": "Ban",
      "type": "object"
    },
    "Bid": {
      "properties": {
        "type": {
          "const": "bid",
          "default": "bid",
          "title": "Type",
          "type": "string"
        },
        "amount": {
          "title": "Amount",
          "type": "integer"
        }
      },
      "required": ["type", "amount"],
      "title": "Bid",
      "type": "object"
    },
    "DuelloMosse": {
      "description": "Le carte giocate in questo turno del duello (segrete fino alla rivelazione).",
      "properties": {
        "type": {
          "const": "duello_mosse",
          "default": "duello_mosse",
          "title": "Type",
          "type": "string"
        },
        "mosse": {
          "items": {
            "$ref": "#/$defs/MossaIn"
          },
          "maxItems": 12,
          "title": "Mosse",
          "type": "array"
        }
      },
      "required": ["type", "mosse"],
      "title": "DuelloMosse",
      "type": "object"
    },
    "Join": {
      "properties": {
        "type": {
          "const": "join",
          "default": "join",
          "title": "Type",
          "type": "string"
        },
        "name": {
          "default": "",
          "maxLength": 24,
          "title": "Name",
          "type": "string"
        },
        "token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token"
        }
      },
      "required": ["type", "name", "token"],
      "title": "Join",
      "type": "object"
    },
    "MossaIn": {
      "properties": {
        "carta": {
          "title": "Carta",
          "type": "string"
        },
        "corsia": {
          "title": "Corsia",
          "type": "integer"
        }
      },
      "required": ["carta", "corsia"],
      "title": "MossaIn",
      "type": "object"
    },
    "Pass": {
      "properties": {
        "type": {
          "const": "pass",
          "default": "pass",
          "title": "Type",
          "type": "string"
        }
      },
      "required": ["type"],
      "title": "Pass",
      "type": "object"
    },
    "Pick": {
      "description": "Draft a specchio: carta scelta e slot dove metterla.",
      "properties": {
        "type": {
          "const": "pick",
          "default": "pick",
          "title": "Type",
          "type": "string"
        },
        "character_id": {
          "title": "Character Id",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": ["type", "character_id", "role"],
      "title": "Pick",
      "type": "object"
    },
    "Plan": {
      "description": "Piano di battaglia: tattiche per le 3 fasi (omesse = a caso), mossa finale, formazione.",
      "properties": {
        "type": {
          "const": "plan",
          "default": "plan",
          "title": "Type",
          "type": "string"
        },
        "tattiche": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tattiche"
        },
        "carica": {
          "default": "subito",
          "enum": ["subito", "carica"],
          "title": "Carica",
          "type": "string"
        },
        "formazione": {
          "default": "classica",
          "title": "Formazione",
          "type": "string"
        }
      },
      "required": ["type", "tattiche", "carica", "formazione"],
      "title": "Plan",
      "type": "object"
    },
    "QuizLobby": {
      "description": "A fine quiz l'host riporta tutti in lobby per rigiocare.",
      "properties": {
        "type": {
          "const": "quiz_lobby",
          "default": "quiz_lobby",
          "title": "Type",
          "type": "string"
        }
      },
      "required": ["type"],
      "title": "QuizLobby",
      "type": "object"
    },
    "QuizRisposta": {
      "description": "Risposta a una domanda del quiz: id dell'anime o del personaggio scelto dall'elenco.",
      "properties": {
        "type": {
          "const": "quiz_risposta",
          "default": "quiz_risposta",
          "title": "Type",
          "type": "string"
        },
        "risposta_id": {
          "title": "Risposta Id",
          "type": "integer"
        }
      },
      "required": ["type", "risposta_id"],
      "title": "QuizRisposta",
      "type": "object"
    },
    "RoomSettings": {
      "properties": {
        "budget": {
          "default": 50,
          "maximum": 500,
          "minimum": 10,
          "title": "Budget",
          "type": "integer"
        },
        "timer": {
          "default": 10,
          "maximum": 60,
          "minimum": 1,
          "title": "Timer",
          "type": "integer"
        },
        "role_timeout": {
          "default": 8,
          "maximum": 60,
          "minimum": 1,
          "title": "Role Timeout",
          "type": "integer"
        },
        "anime": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Anime",
          "type": "array"
        },
        "chat_threshold": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Chat Threshold",
          "type": "integer"
        },
        "bans_per_player": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Bans Per Player",
          "type": "integer"
        },
        "plan_timeout": {
          "default": 45,
          "maximum": 180,
          "minimum": 0,
          "title": "Plan Timeout",
          "type": "integer"
        },
        "formato": {
          "default": "girone",
          "enum": ["girone", "eliminazione"],
          "title": "Formato",
          "type": "string"
        },
        "modalita": {
          "default": "asta",
          "enum": ["asta", "specchio", "raid", "quiz"],
          "title": "Modalita",
          "type": "string"
        },
        "pick_timeout": {
          "default": 20,
          "maximum": 120,
          "minimum": 5,
          "title": "Pick Timeout",
          "type": "integer"
        },
        "boss": {
          "default": "kaido",
          "title": "Boss",
          "type": "string"
        },
        "difficolta": {
          "default": "normale",
          "enum": ["normale", "difficile", "epico"],
          "title": "Difficolta",
          "type": "string"
        },
        "regole": {
          "default": "classico",
          "enum": ["classico", "duello"],
          "title": "Regole",
          "type": "string"
        },
        "turno_duello": {
          "default": 30,
          "maximum": 90,
          "minimum": 10,
          "title": "Turno Duello",
          "type": "integer"
        },
        "quiz_tipo": {
          "default": "misto",
          "enum": ["misto", "scorcio", "personaggio", "indizi", "sigla"],
          "title": "Quiz Tipo",
          "type": "string"
        },
        "quiz_round": {
          "default": 8,
          "maximum": 20,
          "minimum": 3,
          "title": "Quiz Round",
          "type": "integer"
        },
        "quiz_tempo": {
          "default": 25,
          "maximum": 60,
          "minimum": 10,
          "title": "Quiz Tempo",
          "type": "integer"
        }
      },
      "required": [
        "budget",
        "timer",
        "role_timeout",
        "anime",
        "chat_threshold",
        "bans_per_player",
        "plan_timeout",
        "formato",
        "modalita",
        "pick_timeout",
        "boss",
        "difficolta",
        "regole",
        "turno_duello",
        "quiz_tipo",
        "quiz_round",
        "quiz_tempo"
      ],
      "title": "RoomSettings",
      "type": "object"
    },
    "Spectate": {
      "properties": {
        "type": {
          "const": "spectate",
          "default": "spectate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": ["type"],
      "title": "Spectate",
      "type": "object"
    },
    "Start": {
      "properties": {
        "type": {
          "const": "start",
          "default": "start",
          "title": "Type",
          "type": "string"
        }
      },
      "required": ["type"],
      "title": "Start",
      "type": "object"
    },
    "UpdateSettings": {
      "properties": {
        "type": {
          "const": "update_settings",
          "default": "update_settings",
          "title": "Type",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/RoomSettings"
        }
      },
      "required": ["type", "settings"],
      "title": "UpdateSettings",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "assign_role": "#/$defs/AssignRole",
      "ban": "#/$defs/Ban",
      "bid": "#/$defs/Bid",
      "duello_mosse": "#/$defs/DuelloMosse",
      "join": "#/$defs/Join",
      "pass": "#/$defs/Pass",
      "pick": "#/$defs/Pick",
      "plan": "#/$defs/Plan",
      "quiz_lobby": "#/$defs/QuizLobby",
      "quiz_risposta": "#/$defs/QuizRisposta",
      "spectate": "#/$defs/Spectate",
      "start": "#/$defs/Start",
      "update_settings": "#/$defs/UpdateSettings"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Join"
    },
    {
      "$ref": "#/$defs/Spectate"
    },
    {
      "$ref": "#/$defs/Start"
    },
    {
      "$ref": "#/$defs/Ban"
    },
    {
      "$ref": "#/$defs/Bid"
    },
    {
      "$ref": "#/$defs/Pass"
    },
    {
      "$ref": "#/$defs/AssignRole"
    },
    {
      "$ref": "#/$defs/Pick"
    },
    {
      "$ref": "#/$defs/Plan"
    },
    {
      "$ref": "#/$defs/DuelloMosse"
    },
    {
      "$ref": "#/$defs/QuizRisposta"
    },
    {
      "$ref": "#/$defs/QuizLobby"
    },
    {
      "$ref": "#/$defs/UpdateSettings"
    }
  ]
}
